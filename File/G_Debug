template<typename T,typename...Args>
inline void Debug (const std::initializer_list<T>&arr,const Args&...arg)
{
	__G_Debug__::__GDebug_Outer(arr);
	if constexpr (sizeof...(arg)>0) Debug(arg...) ;
	return ;
}
