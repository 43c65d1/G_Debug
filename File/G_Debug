	template<typename T1,typename T2>
	inline std::string to_string (const std::pair<T1,T2>&a)
	{
		return"("+to_string(a.first)+","+to_string(a.second)+")";
	}
	
	template<typename T>
	inline auto to_string (const T&arr) -> decltype(arr.begin(), arr.end(), std::string())
	{
		std::string res{"{"};
		bool Isfirst = 1 ;
		for(const auto&a:arr)
		{
			if(Isfirst)Isfirst=0;
			else res+="," ;
			res+=to_string(a);
		}
		return res+="}" ;
	}
