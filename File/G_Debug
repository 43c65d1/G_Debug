inline void Endproce()
{
	auto EndT = std::chrono::system_clock::now();
	auto EndT_time_t = std::chrono::system_clock::to_time_t(EndT);
	auto EndT_ms = std::chrono::duration_cast<std::chrono::milliseconds>(EndT.time_since_epoch()) % 1000;

	std::tm EndT_tm;
	
	auto end_steady = std::chrono::steady_clock::now();
	auto duration = end_steady - __G_Debug__::Start;
	auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(duration);
	
	// 跨平台安全的 localtime 实现
	// #if defined(_WIN32)
	localtime_s(&EndT_tm, &EndT_time_t);
	// #else
	// localtime_r(&EndT_time_t, &EndT_tm);
	// #endif
	
	std::stringstream os ;
	os << "\n--------Info--------\n" ;
	os << ms.count() << " ms.\n"
	<< std::put_time(&EndT_tm, "%Y/%m/%d\n%H:%M:%S")
	<< '.' << std::setfill('0') << std::setw(3) << EndT_ms.count()
	<< std::endl;
	std::hash<std::string> strH ;
	os << std::uppercase << std::hex << strH(os.str()) ;
	
